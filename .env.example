# ============================================================
# AI Chatbot - Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# ============================================================

# ============================================================
# OpenAI Configuration
# ============================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Default: gpt-4o-mini — cheaper than gpt-3.5-turbo per token, better
# instruction following, comparable latency. If unset, code defaults
# to gpt-4o-mini too.
# Alternatives: gpt-4o (higher quality, ~10x cost), gpt-4-turbo

# Max tokens per reply. Lower it if your provider account has a small credit
# balance — the code also auto-downscales when the provider says it cannot
# afford the requested amount.
OPENAI_MAX_TOKENS=1000

# ============================================================
# Shopify Configuration
# ============================================================
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Format: subdomain.myshopify.com
# Example: your-store.myshopify.com

SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token-here
# Get from: Shopify Admin > Settings > Apps & Integrations > 
#           Develop Apps > [Your App] > Configuration > API Credentials

SHOPIFY_ADMIN_API_TOKEN=your-admin-token-here
# Get from: Shopify Admin > Settings > Apps & Integrations >
#           Develop Apps > [Your App] > Configuration > Admin API

# Optional alternative to a static Admin token: the client-credentials grant
# (Dev Dashboard app). Tokens are fetched and auto-refreshed, so this is the
# recommended option. When both are set, client credentials win.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

SHOPIFY_LOCATION_ID=your-location-id-here
# Get from: Shopify Admin > Settings > Locations
# Used for inventory management (optional)

# Shopify API version. Shopify retires each version after 12 months, so keep
# this current (or leave it unset to use the built-in default).
SHOPIFY_API_VERSION=2026-07

# Custom storefront domain used to build product links (e.g. https://mystore.com).
# Leave unset to fall back to the store's myshopify.com domain.
STORE_FRONT_URL=

# ============================================================
# Server Configuration
# ============================================================
PORT=3000
# Server port for local development
# Production: Usually 3000 or auto-detected by platform

# Public URL of the deployed backend. Used as the OpenRouter HTTP-Referer
# and referenced by the Shopify theme embed.
APP_URL=https://shopify-chatbot-seven.vercel.app

NODE_ENV=development
# Options: development, production, test
# development: More logging, hot-reload
# production: Optimized, minimal logging
# test: For running tests

LOG_LEVEL=debug
# Options: error, warn, info, debug, trace
# debug: Most verbose, useful for development
# info: Production-friendly

# ============================================================
# Security & Performance
# ============================================================
# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# Time window in milliseconds (default: 15 minutes = 900000)

RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window (default: 100)

# Request Timeout
REQUEST_TIMEOUT_MS=30000
# Timeout in milliseconds (default: 30 seconds)

# ============================================================
# Database (Optional - for future use)
# ============================================================
DATABASE_URL=sqlite://./data/chatbot.db
# For SQLite local development
# For production, use PostgreSQL or MongoDB

# ============================================================
# Logging (Optional)
# ============================================================
LOG_FILE_PATH=./logs/app.log
# Path to log file
# Leave empty to disable file logging

# ============================================================
# Monitoring (Optional)
# ============================================================
SENTRY_DSN=
# Sentry error tracking (optional)
# Leave empty to disable

# Langfuse — OpenAI call tracing (optional)
# When both keys are unset, traced() is a no-op and no traffic leaves the box.
# BASEURL must match the region your Langfuse project lives in:
#   https://us.cloud.langfuse.com  (US)
#   https://cloud.langfuse.com     (EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production

# ============================================================
# Development Only
# ============================================================
# These should NEVER be used in production

DEBUG=false
# Enable debug mode
# false: Production
# true: Development (verbose logging)

MOCK_OPENAI=false
# Use mock OpenAI responses (for testing)
# true: Use mocks, don't call actual API
# false: Use real API

MOCK_SHOPIFY=false
# Use mock Shopify responses (for testing)
# true: Use mocks, don't call actual API
# false: Use real API

